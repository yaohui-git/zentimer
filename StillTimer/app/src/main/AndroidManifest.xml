<?xml version="1.0" encoding="utf-8"?>
<!--
  离线冥想闹钟。只申请前台保活所需的 3 项权限，用于「锁屏/切后台也准点响铃」——
  这是原版 TimerPlayer / SleepMixerForegroundService 的核心行为。
  不申请 INTERNET、账号、位置、通讯录、健康数据、内购、广告等任何联网/隐私权限。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：关于页的「联系作者 / 开源地址」交给系统邮件与浏览器应用。
         本应用仍无 INTERNET 权限，这两条只是声明可见性，不申请任何设备能力。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Android 11+ 包可见性：「加微信打赏」需确认 / 唤起微信客户端。
             只是声明可见性，不申请任何设备能力，也不代表本应用会联网。 -->
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StillTimer">

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="meditation_timer_playback" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|fontScale|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
