<?xml version="1.0" encoding="utf-8"?>
<!--
  离线静坐计时器。7 项权限，分两组：
  ① 前台保活、息屏唤醒、锁屏计时展示（5 项）：锁屏/切后台也准点响铃、不解锁就能看到倒计时；
  ② 静坐时免打扰（2 项，v2.25）：ACCESS_NOTIFICATION_POLICY 让本应用能创建并停用
     属于自己的一条 AutomaticZenRule；RECEIVE_BOOT_COMPLETED 只用于重启后收干净残留规则。
  其中 5 项安装即授予，无需用户操作。
  POST_NOTIFICATIONS 是运行时权限：Android 13+ 首次进入时请求一次，用于常驻倒计时与锁屏/状态栏实时信息；
  拒绝只影响通知显示，计时与铃声照常。ACCESS_NOTIFICATION_POLICY 是「特殊访问权限」，只在用户
  主动打开「静坐时免打扰」时才在系统设置里授权一次，开关默认关闭。
  绝不申请 INTERNET、账号、位置、通讯录、健康数据、内购、广告等任何联网/隐私权限。
  也绝不调用改全局勿扰状态的接口；规则停用另有启动自愈、重启、闹钟兜底三道保险。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 普通权限，安装即授予、不弹框：计时期间保持 CPU 唤醒，解决息屏后到点不响 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 普通权限，不弹框：Android 16+ 的「实时动态」——状态栏倒计时胶囊与锁屏实时信息，
         系统闹钟的计时器用的就是这套。不声明这条，setRequestPromotedOngoing 会被系统静默忽略。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- v2.25 静坐时免打扰：只管自己那条 AutomaticZenRule，不改全局勿扰状态。
         需用户在系统「勿扰权限」页亲手授权一次；未授权时开关弹回关闭且不阻断计时。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- v2.25 复原底线：手机在静坐中重启时，不打开 App 也要把残留规则停用。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：关于页的「联系作者 / 开源地址」交给系统邮件与浏览器应用。
         本应用仍无 INTERNET 权限，这两条只是声明可见性，不申请任何设备能力。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ZenApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZenTimer">

        <!-- 系统状态复原：重启 / 覆盖升级 / 兜底闹钟，三条触发源都只做「停用自有规则」。
             不加 android:permission 是有意的：底线是「绝不漏收」，个别 ROM 对带权限校验的
             系统广播投递不稳定；停用幂等且后果极轻（最坏是免打扰提前关掉），宁可多收一次。
             兜底闹钟那条是显式 PendingIntent，本进程自己发，不依赖隐式广播豁免。 -->
        <receiver
            android:name=".DndRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.yaohui.zentimer.DND_RESTORE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="meditation_timer_playback" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|fontScale|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v2.25：作为自有勿扰规则的配置入口。系统「模式」列表里点「静坐」
                 会带 EXTRA_AUTOMATIC_ZEN_RULE_ID 回到主界面；不新增页面、不弹询问。 -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
